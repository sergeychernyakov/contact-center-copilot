# ─── LLM provider ───────────────────────────────────────────────────────────
# Choose: "ollama" (free, fully local), "groq" (free, hosted), "anthropic" (paid).
LLM_PROVIDER=ollama

# ─── Groq (free) ────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com — Google account, 1 minute.
# Heads up:
#   - Model availability varies by account. Llama-3.x models often require
#     accepting Meta's licence in console.groq.com before they work; without
#     that, the API returns 401 "Invalid API Key" for those models specifically.
#   - The free tier's edge fleet occasionally returns a flaky 401 for valid
#     keys when a request lands on a node that hasn't picked up the key from
#     the auth backend. `src/agents/_llm.py` wraps every structured-output
#     call with `Runnable.with_retry(AuthenticationError, RateLimitError)` so
#     those go away after 1-2 retries.
GROQ_API_KEY=gsk_your_key_here

# ─── Anthropic (paid, optional) ─────────────────────────────────────────────
# Only needed if LLM_PROVIDER=anthropic. Get at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Ollama (free, fully local — no API key) ────────────────────────────────
# Install: `brew install ollama`, then `ollama serve` and `ollama pull qwen2.5:14b`.
# Set LLM_PROVIDER=ollama and point MODEL_FAST/MODEL_HEAVY at pulled models below.
OLLAMA_BASE_URL=http://localhost:11434

# ─── Models ─────────────────────────────────────────────────────────────────
# Ollama defaults (pull with: ollama pull qwen2.5:14b). Qwen2.5 handles the
# report's structured schema far better than small Llama models — it was the
# only local model in our tests that produced faithfulness ≥ 0.85 on the first
# Critic pass without a retry loop.
MODEL_FAST=qwen2.5:14b
MODEL_HEAVY=qwen2.5:14b

# Groq alternatives (set LLM_PROVIDER=groq to use). Pick from whatever is
# available on your account — list current models at:
#   https://console.groq.com/docs/models
# Confirmed working without the Meta-licence dance:
# MODEL_FAST=meta-llama/llama-4-scout-17b-16e-instruct
# MODEL_HEAVY=openai/gpt-oss-120b
# qwen/qwen3-32b is best for structured output but has a tight 6K TPM limit
# on free tier — the Reporter's three parallel calls hit it instantly.
# llama-3.1-8b-instant / llama-3.3-70b-versatile need the Meta licence first.

# Anthropic alternatives (set LLM_PROVIDER=anthropic to use):
# MODEL_FAST=claude-haiku-4-5-20251001
# MODEL_HEAVY=claude-sonnet-4-6

# Embeddings — local by default (no API key needed).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Observability (optional) ───────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=contact-center-copilot
LANGSMITH_TRACING=false

# ─── Pipeline behaviour ─────────────────────────────────────────────────────
FAITHFULNESS_THRESHOLD=0.85
MAX_REPORTER_ATTEMPTS=3
RETRIEVER_TOP_K=5
