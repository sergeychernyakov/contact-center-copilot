# --- LLM provider (Anthropic Claude) ---
ANTHROPIC_API_KEY=sk-ant-xxx-replace-me

# Models — sensible defaults, override per agent if needed
LLM_MODEL_ANALYSIS=claude-sonnet-4-6
LLM_MODEL_ROUTING=claude-haiku-4-5-20251001
LLM_MODEL_JUDGE=claude-opus-4-7

# --- Observability (optional but recommended) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=contact-center-copilot

# --- Embeddings ---
# local | openai | voyage
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store ---
VECTOR_STORE_DIR=./data/vector_store
VECTOR_STORE_BACKEND=faiss

# --- Reranker (optional) ---
COHERE_API_KEY=
USE_RERANKER=false

# --- Pipeline tuning ---
MAX_CRITIC_ATTEMPTS=3
FAITHFULNESS_THRESHOLD=0.85
CITATION_COVERAGE_THRESHOLD=0.80

# --- App ---
LOG_LEVEL=INFO
STREAMLIT_PORT=8501
