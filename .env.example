# ─── LLM provider ───────────────────────────────────────────────────────────
# Choose: "ollama" (free, fully local), "groq" (free, hosted), "anthropic" (paid).
LLM_PROVIDER=ollama

# ─── Groq (free) ────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com — Google account, 1 minute.
GROQ_API_KEY=gsk_your_key_here

# ─── Anthropic (paid, optional) ─────────────────────────────────────────────
# Only needed if LLM_PROVIDER=anthropic. Get at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ─── Ollama (free, fully local — no API key) ────────────────────────────────
# Install: `brew install ollama`, then `ollama serve` and `ollama pull llama3.1:8b`.
# Set LLM_PROVIDER=ollama and point MODEL_FAST/MODEL_HEAVY at pulled models below.
OLLAMA_BASE_URL=http://localhost:11434

# ─── Models ─────────────────────────────────────────────────────────────────
# Ollama defaults (pull with: ollama pull qwen2.5:14b). Qwen2.5 handles the
# report's structured schema far better than small Llama models.
MODEL_FAST=qwen2.5:14b
MODEL_HEAVY=qwen2.5:14b

# Groq alternatives (set LLM_PROVIDER=groq to use):
# MODEL_FAST=llama-3.1-8b-instant
# MODEL_HEAVY=llama-3.3-70b-versatile

# Anthropic alternatives (set LLM_PROVIDER=anthropic to use):
# MODEL_FAST=claude-haiku-4-5-20251001
# MODEL_HEAVY=claude-sonnet-4-6

# Embeddings — local by default (no API key needed).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ─── Observability (optional) ───────────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=contact-center-copilot
LANGSMITH_TRACING=false

# ─── Pipeline behaviour ─────────────────────────────────────────────────────
FAITHFULNESS_THRESHOLD=0.85
MAX_REPORTER_ATTEMPTS=3
RETRIEVER_TOP_K=5
